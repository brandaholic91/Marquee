{
  "name": "marquee-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently --names server,web --prefix-colors cyan,magenta \"npm run dev --workspace=packages/server\" \"npm run dev --workspace=packages/web\"",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces --if-present",
    "check": "biome check .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "typebox": "1.1.24"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "concurrently": "^9.2.1",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "typebox": "1.1.24"
  }
}
